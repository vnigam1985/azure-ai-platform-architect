<!--
  Week 4 AI gateway policy for the bank assistant API.
  Based on gateway/apim-policies/01-token-limit-and-metrics.xml.
  __TPM__ and __QUOTA__ are replaced by main.bicep.
-->
<policies>
    <inbound>
        <base />
        <set-backend-service backend-id="foundry-backend" />
        <!-- APIM calls Foundry with its own managed identity. Apps never hold a model key. -->
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
        <!-- Per-subscription token budget: 429 over the per-minute limit, 403 when the monthly quota is used up. -->
        <llm-token-limit
            counter-key="@(context.Subscription.Id)"
            tokens-per-minute="__TPM__"
            token-quota="__QUOTA__"
            token-quota-period="Monthly"
            estimate-prompt-tokens="false"
            remaining-tokens-header-name="x-remaining-tokens"
            tokens-consumed-header-name="x-tokens-consumed" />
        <!-- Token metrics to Application Insights, per subscription and team, for chargeback (week 7). -->
        <llm-emit-token-metric namespace="ai-gateway">
            <dimension name="Subscription ID" />
            <dimension name="API ID" />
            <dimension name="Team" value="@(context.Subscription?.Name ?? &quot;none&quot;)" />
        </llm-emit-token-metric>
    </inbound>
    <backend>
        <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="2" interval="1" first-fast-retry="true">
            <forward-request buffer-request-body="true" />
        </retry>
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
